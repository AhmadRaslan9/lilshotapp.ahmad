rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function validUsername(value) {
      return value is string && value.size() >= 3 && value.size() <= 20
        && value.matches('^[a-z0-9_][a-z0-9_.]{1,18}[a-z0-9_]$')
        && !value.matches('.*[.][.].*');
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid','displayName','username','usernameLower','accountType','privacy','role','plan','accountStatus','verified','points','followersCount','followingCount','postsCount','momentsCount','bio','photoURL','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','displayName','username','usernameLower','accountType','privacy','role','plan','accountStatus','verified','points','followersCount','followingCount','postsCount','momentsCount','bio','photoURL','createdAt','updatedAt'])
        && data.uid == uid && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40
        && validUsername(data.usernameLower) && data.username == data.usernameLower
        && data.accountType in ['user', 'cafe'] && data.privacy in ['public', 'private']
        && data.role == 'user' && data.verified == false && data.points == 0
        && data.followersCount == 0 && data.followingCount == 0 && data.postsCount == 0 && data.momentsCount == 0
        && ((data.accountType == 'user' && data.plan == 'free' && data.accountStatus == 'active')
          || (data.accountType == 'cafe' && data.plan == 'cafe_pending' && data.accountStatus == 'pending_subscription'))
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if admin() || owner(uid) || (signedIn() && resource.data.privacy == 'public');
      allow list: if admin() || (signedIn()
        && resource.data.accountType == 'cafe'
        && resource.data.accountStatus == 'active'
        && resource.data.privacy == 'public');
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.ownerUid == uid;
      allow update: if admin() || (owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','privacy','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.privacy in ['public', 'private'] && request.resource.data.updatedAt == request.time);
      allow delete: if admin();
    }
    function targetCanBeFollowed(targetUid) {
      let target = get(/databases/$(database)/documents/users/$(targetUid)).data;
      return signedIn() && target.privacy == 'public' && target.accountStatus == 'active';
    }
    function validRelationship(data, followerUid, targetUid) {
      return data.keys().hasAll(['followerUid','targetUid','createdAt'])
        && data.keys().hasOnly(['followerUid','targetUid','createdAt'])
        && data.followerUid == followerUid
        && data.targetUid == targetUid
        && followerUid != targetUid
        && data.createdAt == request.time;
    }
    match /users/{targetUid}/followers/{followerUid} {
      allow read: if admin() || owner(targetUid) || (signedIn()
        && get(/databases/$(database)/documents/users/$(targetUid)).data.privacy == 'public');
      allow create: if signedIn() && request.auth.uid == followerUid
        && targetCanBeFollowed(targetUid)
        && validRelationship(request.resource.data, followerUid, targetUid)
        && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)).data.followerUid == followerUid
        && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)).data.targetUid == targetUid;
      allow update: if false;
      allow delete: if admin() || (signedIn() && request.auth.uid == followerUid
        && !existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)));
    }
    match /users/{followerUid}/following/{targetUid} {
      allow read: if admin() || owner(followerUid);
      allow create: if signedIn() && request.auth.uid == followerUid
        && targetCanBeFollowed(targetUid)
        && validRelationship(request.resource.data, followerUid, targetUid)
        && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid)).data.followerUid == followerUid
        && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid)).data.targetUid == targetUid;
      allow update: if false;
      allow delete: if admin() || (owner(followerUid)
        && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid)));
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if admin();
      allow create: if signedIn() && validUsername(username)
        && request.resource.data.keys().hasAll(['ownerUid','createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username;
      allow update, delete: if admin();
    }
    match /adminAudit/{entryId} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
    function profileCanPublishPost(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return owner(uid)
        && profile.accountStatus == 'active'
        && profile.privacy == 'public'
        && ((profile.accountType == 'user' && profile.plan == 'plus')
          || (profile.accountType == 'cafe' && profile.plan in ['cafe_basic', 'cafe_pro']));
    }
    function validPost(data) {
      let profile = get(/databases/$(database)/documents/users/$(data.authorUid)).data;
      return data.keys().hasAll(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','likesCount','createdAt','updatedAt'])
        && data.keys().hasOnly(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','likesCount','createdAt','updatedAt'])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && data.authorName == profile.displayName
        && data.authorUsername == profile.usernameLower
        && data.authorPhotoURL == profile.photoURL
        && data.authorVerified == profile.verified
        && data.authorType == profile.accountType
        && data.imageURL is string && data.imageURL.size() >= 9 && data.imageURL.size() <= 1000
        && data.imageURL.matches('^https://.*')
        && data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 500
        && data.locationName is string && data.locationName.size() <= 100
        && data.visibility == 'public'
        && data.status in ['published', 'hidden']
        && data.likesCount is int && data.likesCount >= 0;
    }
    function validLikeCountChange(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount','updatedAt'])
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0
        && request.resource.data.updatedAt == request.time
        && ((!exists(likePath) && existsAfter(likePath)
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1)
          || (exists(likePath) && !existsAfter(likePath)
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1));
    }
    match /posts/{postId} {
      allow get: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (signedIn() && resource.data.status == 'published' && resource.data.visibility == 'public');
      allow list: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (signedIn() && resource.data.status == 'published' && resource.data.visibility == 'public');
      allow create: if signedIn()
        && profileCanPublishPost(request.resource.data.authorUid)
        && validPost(request.resource.data)
        && request.resource.data.status == 'published'
        && request.resource.data.likesCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['published','hidden']
          && request.resource.data.updatedAt == request.time)
        || (signedIn() && resource.data.status == 'published'
          && resource.data.visibility == 'public' && validLikeCountChange(postId));
      allow delete: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    function validPostLike(data, postId, userUid) {
      return data.keys().hasAll(['postId','userUid','createdAt'])
        && data.keys().hasOnly(['postId','userUid','createdAt'])
        && data.postId == postId
        && data.userUid == userUid
        && data.createdAt == request.time;
    }
    match /posts/{postId}/likes/{userUid} {
      allow get: if admin() || (signedIn() && request.auth.uid == userUid);
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == userUid
        && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published'
        && get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public'
        && validPostLike(request.resource.data, postId, userUid)
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
          == get(/databases/$(database)/documents/posts/$(postId)).data.get('likesCount', 0) + 1;
      allow update: if false;
      allow delete: if admin() || (signedIn() && request.auth.uid == userUid
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
          == get(/databases/$(database)/documents/posts/$(postId)).data.get('likesCount', 0) - 1);
    }
    function cafeIsActive(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return signedIn() && cafe.accountType == 'cafe'
        && cafe.accountStatus == 'active'
        && cafe.plan in ['cafe_basic', 'cafe_pro'];
    }
    function canManageCafe(cafeUid) {
      return owner(cafeUid) && cafeIsActive(cafeUid);
    }
    function cafeIsDiscoverable(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return cafeIsActive(cafeUid) && cafe.privacy == 'public';
    }
    function cafeOwnerMayEdit(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return owner(cafeUid) && cafe.accountType == 'cafe' && cafe.accountStatus != 'banned';
    }
    function validStoreHours(hours) {
      return hours is map
        && hours.keys().hasAll(['saturday','sunday','monday','tuesday','wednesday','thursday','friday'])
        && hours.keys().hasOnly(['saturday','sunday','monday','tuesday','wednesday','thursday','friday'])
        && hours.saturday is string && hours.saturday.size() <= 40
        && hours.sunday is string && hours.sunday.size() <= 40
        && hours.monday is string && hours.monday.size() <= 40
        && hours.tuesday is string && hours.tuesday.size() <= 40
        && hours.wednesday is string && hours.wednesday.size() <= 40
        && hours.thursday is string && hours.thursday.size() <= 40
        && hours.friday is string && hours.friday.size() <= 40;
    }
    function validStoreDetails(data, cafeUid) {
      return data.keys().hasAll(['ownerUid','city','district','address','mapsURL','category','description','coverURL','logoURL','hours','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerUid','city','district','address','mapsURL','category','description','coverURL','logoURL','hours','createdAt','updatedAt'])
        && data.ownerUid == cafeUid
        && data.city in ['الرياض','جدة','مكة','المدينة','الخبر','الدمام','الطائف','أبها','أخرى']
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 160
        && data.mapsURL is string && data.mapsURL.size() <= 1000
        && data.category in ['قهوة مختصة','مقهى','حلويات','فطور','جلسات خارجية']
        && data.description is string && data.description.size() <= 500
        && data.coverURL is string && data.coverURL.size() <= 1000
        && data.logoURL is string && data.logoURL.size() <= 1000
        && validStoreHours(data.hours);
    }
    match /cafes/{cafeUid} {
      allow get: if admin() || cafeOwnerMayEdit(cafeUid) || cafeIsDiscoverable(cafeUid);
      allow list: if false;
      allow create: if cafeOwnerMayEdit(cafeUid)
        && validStoreDetails(request.resource.data, cafeUid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin() || cafeOwnerMayEdit(cafeUid))
        && validStoreDetails(request.resource.data, cafeUid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    function validMenuItem(data, cafeUid) {
      return data.keys().hasAll(['ownerUid','name','description','price','category','available','imageURL','sortOrder','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerUid','name','description','price','category','available','imageURL','sortOrder','createdAt','updatedAt'])
        && data.ownerUid == cafeUid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 200
        && data.price is number && data.price >= 0 && data.price <= 10000
        && data.category in ['قهوة ساخنة', 'قهوة باردة', 'حلويات', 'فطور', 'أخرى']
        && data.available is bool
        && data.imageURL is string && data.imageURL.size() <= 1000
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 9999;
    }
    match /cafes/{cafeUid}/menuItems/{itemId} {
      allow read: if admin() || canManageCafe(cafeUid) || cafeIsDiscoverable(cafeUid);
      allow create: if canManageCafe(cafeUid)
        && validMenuItem(request.resource.data, cafeUid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin() || canManageCafe(cafeUid))
        && validMenuItem(request.resource.data, cafeUid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() || canManageCafe(cafeUid);
    }
  }
}
