rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function subscriptionActive(profile) {
      return !profile.keys().hasAny(['subscriptionEndsAt']) || profile.subscriptionEndsAt == null || profile.subscriptionEndsAt > request.time;
    }
    function blockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/blocks/$(secondUid))
        || exists(/databases/$(database)/documents/users/$(secondUid)/blocks/$(firstUid));
    }
    function validUsername(value) {
      return value is string && value.size() >= 3 && value.size() <= 20
        && value.matches('^[a-z0-9_][a-z0-9_.]{1,18}[a-z0-9_]$')
        && !value.matches('.*[.][.].*');
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid','displayName','username','usernameLower','accountType','privacy','role','plan','accountStatus','verified','points','followersCount','followingCount','postsCount','momentsCount','bio','photoURL','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','displayName','username','usernameLower','accountType','privacy','role','plan','accountStatus','verified','points','followersCount','followingCount','postsCount','momentsCount','bio','photoURL','createdAt','updatedAt'])
        && data.uid == uid && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40
        && validUsername(data.usernameLower) && data.username == data.usernameLower
        && data.accountType in ['user', 'cafe'] && data.privacy in ['public', 'private']
        && data.role == 'user' && data.verified == false && data.points == 0
        && data.followersCount == 0 && data.followingCount == 0 && data.postsCount == 0 && data.momentsCount == 0
        && ((data.accountType == 'user' && data.plan == 'free' && data.accountStatus == 'active')
          || (data.accountType == 'cafe' && data.plan == 'cafe_pending' && data.accountStatus == 'pending_subscription'))
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if admin() || owner(uid) || (signedIn()
        && resource.data.accountStatus == 'active'
        && !blockedBetween(request.auth.uid, uid));
      allow list: if admin() || (signedIn()
        && resource.data.accountStatus == 'active');
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.ownerUid == uid;
      allow update: if admin() || (owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','privacy','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.privacy in ['public', 'private'] && request.resource.data.updatedAt == request.time);
      allow delete: if admin();
    }
    function validInvite(data, ownerUid, slot) {
      return slot in ['1','2','3']
        && data.keys().hasAll(['ownerUid','slot','code','status','usedByUid','createdAt','usedAt'])
        && data.keys().hasOnly(['ownerUid','slot','code','status','usedByUid','createdAt','usedAt'])
        && data.ownerUid == ownerUid
        && ((slot == '1' && data.slot == 1) || (slot == '2' && data.slot == 2) || (slot == '3' && data.slot == 3))
        && data.code is string && data.code.size() >= 10 && data.code.size() <= 24
        && data.status == 'active' && data.usedByUid == ''
        && data.createdAt == request.time && data.usedAt == null;
    }
    match /users/{ownerUid}/invites/{slot} {
      allow read: if admin() || owner(ownerUid);
      allow create: if owner(ownerUid) && validInvite(request.resource.data, ownerUid, slot);
      allow update, delete: if admin();
    }
    function validBlock(data, blockerUid, blockedUid) {
      let target = get(/databases/$(database)/documents/users/$(blockedUid)).data;
      return data.keys().hasAll(['blockerUid','blockedUid','blockedName','blockedUsername','blockedPhotoURL','blockedType','createdAt'])
        && data.keys().hasOnly(['blockerUid','blockedUid','blockedName','blockedUsername','blockedPhotoURL','blockedType','createdAt'])
        && blockerUid != blockedUid
        && data.blockerUid == blockerUid
        && data.blockedUid == blockedUid
        && data.blockedName == target.displayName
        && data.blockedUsername == target.usernameLower
        && data.blockedPhotoURL == target.photoURL
        && data.blockedType == target.accountType
        && data.createdAt == request.time;
    }
    match /users/{blockerUid}/blocks/{blockedUid} {
      allow read: if admin() || owner(blockerUid);
      allow create: if owner(blockerUid)
        && validBlock(request.resource.data, blockerUid, blockedUid)
        && getAfter(/databases/$(database)/documents/users/$(blockedUid)/blockedBy/$(blockerUid)).data.blockerUid == blockerUid;
      allow update: if false;
      allow delete: if admin() || (owner(blockerUid)
        && !existsAfter(/databases/$(database)/documents/users/$(blockedUid)/blockedBy/$(blockerUid)));
    }
    match /users/{blockedUid}/blockedBy/{blockerUid} {
      allow read: if admin() || owner(blockedUid);
      allow create: if owner(blockerUid)
        && validBlock(request.resource.data, blockerUid, blockedUid)
        && getAfter(/databases/$(database)/documents/users/$(blockerUid)/blocks/$(blockedUid)).data.blockedUid == blockedUid;
      allow update: if false;
      allow delete: if admin() || (owner(blockerUid)
        && !existsAfter(/databases/$(database)/documents/users/$(blockerUid)/blocks/$(blockedUid)));
    }
    function targetCanBeFollowed(targetUid) {
      let target = get(/databases/$(database)/documents/users/$(targetUid)).data;
      return signedIn() && target.privacy == 'public' && target.accountStatus == 'active'
        && !blockedBetween(request.auth.uid, targetUid);
    }
    function targetAcceptsFollowRequests(targetUid) {
      let target = get(/databases/$(database)/documents/users/$(targetUid)).data;
      return signedIn() && target.privacy == 'private' && target.accountStatus == 'active'
        && !blockedBetween(request.auth.uid, targetUid);
    }
    function validRelationship(data, followerUid, targetUid) {
      return data.keys().hasAll(['followerUid','targetUid','createdAt'])
        && data.keys().hasOnly(['followerUid','targetUid','createdAt'])
        && data.followerUid == followerUid
        && data.targetUid == targetUid
        && followerUid != targetUid
        && data.createdAt == request.time;
    }
    match /users/{targetUid}/followers/{followerUid} {
      allow read: if admin() || owner(targetUid) || (signedIn()
        && (get(/databases/$(database)/documents/users/$(targetUid)).data.privacy == 'public'
          || exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(request.auth.uid))));
      allow create: if signedIn()
        && !blockedBetween(followerUid, targetUid)
        && ((request.auth.uid == followerUid && targetCanBeFollowed(targetUid))
          || (request.auth.uid == targetUid
            && exists(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(followerUid))
            && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(followerUid))))
        && validRelationship(request.resource.data, followerUid, targetUid)
        && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)).data.followerUid == followerUid
        && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)).data.targetUid == targetUid;
      allow update: if false;
      allow delete: if admin() || (signedIn()
        && !existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid))
        && ((request.auth.uid == followerUid
              && existsAfter(/databases/$(database)/documents/users/$(followerUid)/blocks/$(targetUid)))
          || (request.auth.uid == targetUid
              && existsAfter(/databases/$(database)/documents/users/$(targetUid)/blocks/$(followerUid)))
          || request.auth.uid == followerUid));
    }
    match /users/{followerUid}/following/{targetUid} {
      allow read: if admin() || owner(followerUid);
      allow create: if signedIn()
        && !blockedBetween(followerUid, targetUid)
        && ((request.auth.uid == followerUid && targetCanBeFollowed(targetUid))
          || (request.auth.uid == targetUid
            && exists(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(followerUid))
            && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(followerUid))))
        && validRelationship(request.resource.data, followerUid, targetUid)
        && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid)).data.followerUid == followerUid
        && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid)).data.targetUid == targetUid;
      allow update: if false;
      allow delete: if admin() || (signedIn()
        && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid))
        && ((request.auth.uid == followerUid
              && existsAfter(/databases/$(database)/documents/users/$(followerUid)/blocks/$(targetUid)))
          || (request.auth.uid == targetUid
              && existsAfter(/databases/$(database)/documents/users/$(targetUid)/blocks/$(followerUid)))
          || request.auth.uid == followerUid));
    }
    function validFollowRequest(data, requesterUid, targetUid) {
      return data.keys().hasAll(['requesterUid','targetUid','createdAt'])
        && data.keys().hasOnly(['requesterUid','targetUid','createdAt'])
        && data.requesterUid == requesterUid
        && data.targetUid == targetUid
        && requesterUid != targetUid
        && data.createdAt == request.time;
    }
    match /users/{targetUid}/followRequests/{requesterUid} {
      allow get: if admin() || owner(targetUid) || (signedIn() && request.auth.uid == requesterUid);
      allow list: if admin() || owner(targetUid);
      allow create: if signedIn() && request.auth.uid == requesterUid
        && targetAcceptsFollowRequests(targetUid)
        && validFollowRequest(request.resource.data, requesterUid, targetUid)
        && !exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(requesterUid));
      allow update: if false;
      allow delete: if admin() || owner(targetUid) || (signedIn() && request.auth.uid == requesterUid);
    }
    function validNotification(data, targetUid) {
      let actor = get(/databases/$(database)/documents/users/$(data.actorUid)).data;
      return !blockedBetween(data.actorUid, targetUid)
        && data.keys().hasAll(['type','actorUid','actorName','actorUsername','targetUid','postId','read','createdAt','readAt'])
        && data.keys().hasOnly(['type','actorUid','actorName','actorUsername','targetUid','postId','read','createdAt','readAt'])
        && data.type in ['follow','follow_request','follow_accepted','like']
        && data.actorUid == request.auth.uid
        && data.actorUid != targetUid
        && data.targetUid == targetUid
        && data.actorName == actor.displayName
        && data.actorUsername == actor.usernameLower
        && data.postId is string
        && data.read == false
        && data.createdAt == request.time
        && data.readAt == null;
    }
    function notificationMatchesEvent(notificationId, data, targetUid) {
      return (data.type == 'follow'
          && data.postId == ''
          && notificationId == 'follow_' + data.actorUid
          && !exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(data.actorUid))
          && existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(data.actorUid)))
        || (data.type == 'follow_request'
          && data.postId == ''
          && notificationId == 'follow_request_' + data.actorUid
          && !exists(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(data.actorUid))
          && existsAfter(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(data.actorUid)))
        || (data.type == 'follow_accepted'
          && data.postId == ''
          && exists(/databases/$(database)/documents/users/$(data.actorUid)/followRequests/$(targetUid))
          && !existsAfter(/databases/$(database)/documents/users/$(data.actorUid)/followRequests/$(targetUid))
          && existsAfter(/databases/$(database)/documents/users/$(targetUid)/following/$(data.actorUid)))
        || (data.type == 'like'
          && notificationId == 'like_' + data.postId + '_' + data.actorUid
          && get(/databases/$(database)/documents/posts/$(data.postId)).data.authorUid == targetUid
          && !exists(/databases/$(database)/documents/posts/$(data.postId)/likes/$(data.actorUid))
          && existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(data.actorUid)));
    }
    function notificationEventWasRemoved(data, targetUid) {
      return (data.type == 'follow'
          && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(data.actorUid)))
        || (data.type == 'follow_request'
          && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(data.actorUid)))
        || (data.type == 'like'
          && !existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(data.actorUid)));
    }
    match /users/{targetUid}/notifications/{notificationId} {
      allow get: if admin() || owner(targetUid) || (signedIn()
        && (notificationId == 'follow_' + request.auth.uid
          || notificationId == 'follow_request_' + request.auth.uid
          || notificationId.matches('^like_.*_' + request.auth.uid + '$')));
      allow list: if admin() || owner(targetUid);
      allow create: if signedIn()
        && validNotification(request.resource.data, targetUid)
        && notificationMatchesEvent(notificationId, request.resource.data, targetUid);
      allow update: if owner(targetUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow delete: if admin() || owner(targetUid) || (signedIn()
        && request.auth.uid == resource.data.actorUid
        && notificationEventWasRemoved(resource.data, targetUid));
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if admin();
      allow create: if signedIn() && validUsername(username)
        && request.resource.data.keys().hasAll(['ownerUid','createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username;
      allow update, delete: if admin();
    }
    match /adminAudit/{entryId} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
    function reportTargetMatches(data) {
      return ((data.targetType in ['account', 'cafe'])
          && exists(/databases/$(database)/documents/users/$(data.targetId))
          && data.targetOwnerUid == data.targetId
          && ((data.targetType == 'account'
                && get(/databases/$(database)/documents/users/$(data.targetId)).data.accountType == 'user')
            || (data.targetType == 'cafe'
                && get(/databases/$(database)/documents/users/$(data.targetId)).data.accountType == 'cafe')))
        || (data.targetType == 'post'
          && exists(/databases/$(database)/documents/posts/$(data.targetId))
          && get(/databases/$(database)/documents/posts/$(data.targetId)).data.authorUid == data.targetOwnerUid)
        || (data.targetType == 'moment'
          && exists(/databases/$(database)/documents/moments/$(data.targetId))
          && get(/databases/$(database)/documents/moments/$(data.targetId)).data.authorUid == data.targetOwnerUid);
    }
    function validNewReport(data, reportId) {
      let reporter = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.keys().hasAll(['reporterUid','reporterName','reporterUsername','targetType','targetId','targetOwnerUid','targetLabel','targetPreview','reason','details','status','resolution','reviewedAt','reviewedByUid','createdAt','updatedAt'])
        && data.keys().hasOnly(['reporterUid','reporterName','reporterUsername','targetType','targetId','targetOwnerUid','targetLabel','targetPreview','reason','details','status','resolution','reviewedAt','reviewedByUid','createdAt','updatedAt'])
        && data.reporterUid == request.auth.uid
        && data.reporterName == reporter.displayName
        && data.reporterUsername == reporter.usernameLower
        && data.targetType in ['account','cafe','post','moment']
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 160
        && data.targetOwnerUid is string && data.targetOwnerUid.size() >= 1
        && data.targetOwnerUid != request.auth.uid
        && data.targetLabel is string && data.targetLabel.size() <= 120
        && data.targetPreview is string && data.targetPreview.size() <= 1000
        && data.reason in ['spam','inappropriate','impersonation','harassment','other']
        && data.details is string && data.details.size() <= 300
        && data.status == 'pending'
        && data.resolution == ''
        && data.reviewedAt == null
        && data.reviewedByUid == ''
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && reportId == request.auth.uid + '_' + data.targetType + '_' + data.targetId
        && reportTargetMatches(data);
    }
    match /reports/{reportId} {
      allow get: if admin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow list: if admin();
      allow create: if signedIn() && validNewReport(request.resource.data, reportId);
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','reviewedAt','reviewedByUid','updatedAt'])
        && request.resource.data.status in ['resolved','dismissed']
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() >= 2
        && request.resource.data.resolution.size() <= 500
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function profileCanPublishPost(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return owner(uid)
        && profile.accountStatus == 'active' && subscriptionActive(profile)
        && ((profile.accountType == 'user' && profile.plan == 'plus')
          || (profile.accountType == 'cafe' && profile.plan in ['cafe_basic', 'cafe_pro']));
    }
    function validPost(data) {
      let profile = get(/databases/$(database)/documents/users/$(data.authorUid)).data;
      return data.keys().hasAll(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','likesCount','createdAt','updatedAt'])
        && data.keys().hasOnly(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','likesCount','createdAt','updatedAt'])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && data.authorName == profile.displayName
        && data.authorUsername == profile.usernameLower
        && data.authorPhotoURL == profile.photoURL
        && data.authorVerified == profile.verified
        && data.authorType == profile.accountType
        && data.imageURL is string && data.imageURL.size() >= 9 && data.imageURL.size() <= 1000
        && data.imageURL.matches('^https://.*')
        && data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 500
        && data.locationName is string && data.locationName.size() <= 100
        && ((profile.privacy == 'public' && data.visibility == 'public')
          || (profile.privacy == 'private' && data.visibility == 'followers'))
        && data.status in ['published', 'hidden']
        && data.likesCount is int && data.likesCount >= 0;
    }
    function validLikeCountChange(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount','updatedAt'])
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0
        && request.resource.data.updatedAt == request.time
        && ((!exists(likePath) && existsAfter(likePath)
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1)
          || (exists(likePath) && !existsAfter(likePath)
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1));
    }
    function canReadPublishedPost(data) {
      return signedIn() && data.status == 'published'
        && !blockedBetween(request.auth.uid, data.authorUid)
        && (data.visibility == 'public'
          || (data.visibility == 'followers'
            && exists(/databases/$(database)/documents/users/$(data.authorUid)/followers/$(request.auth.uid))));
    }
    function canListPublishedPost(data) {
      return signedIn() && data.status == 'published'
        && (data.visibility == 'public'
          || (data.visibility == 'followers'
            && exists(/databases/$(database)/documents/users/$(data.authorUid)/followers/$(request.auth.uid))));
    }
    match /posts/{postId} {
      allow get: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || canReadPublishedPost(resource.data);
      allow list: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || canListPublishedPost(resource.data);
      allow create: if signedIn()
        && profileCanPublishPost(request.resource.data.authorUid)
        && validPost(request.resource.data)
        && request.resource.data.status == 'published'
        && request.resource.data.likesCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['published','hidden']
          && request.resource.data.updatedAt == request.time)
        || (canReadPublishedPost(resource.data) && validLikeCountChange(postId));
      allow delete: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    function validPostLike(data, postId, userUid) {
      return data.keys().hasAll(['postId','userUid','createdAt'])
        && data.keys().hasOnly(['postId','userUid','createdAt'])
        && data.postId == postId
        && data.userUid == userUid
        && data.createdAt == request.time;
    }
    match /posts/{postId}/likes/{userUid} {
      allow get: if admin() || (signedIn() && request.auth.uid == userUid);
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == userUid
        && canReadPublishedPost(get(/databases/$(database)/documents/posts/$(postId)).data)
        && validPostLike(request.resource.data, postId, userUid)
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
          == get(/databases/$(database)/documents/posts/$(postId)).data.get('likesCount', 0) + 1;
      allow update: if false;
      allow delete: if admin() || (signedIn() && request.auth.uid == userUid
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount
          == get(/databases/$(database)/documents/posts/$(postId)).data.get('likesCount', 0) - 1);
    }
    function profileCanPublishMoment(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return owner(uid)
        && profile.accountStatus == 'active'
        && profile.privacy in ['public', 'private']
        && (profile.accountType == 'user'
          || (profile.accountType == 'cafe' && subscriptionActive(profile) && profile.plan in ['cafe_basic', 'cafe_pro']));
    }
    function validMoment(data) {
      let profile = get(/databases/$(database)/documents/users/$(data.authorUid)).data;
      return data.keys().hasAll(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','durationHours','expiresAt','createdAt','updatedAt'])
        && data.keys().hasOnly(['authorUid','authorName','authorUsername','authorPhotoURL','authorVerified','authorType','imageURL','caption','locationName','visibility','status','durationHours','expiresAt','createdAt','updatedAt'])
        && data.authorUid == request.auth.uid
        && data.authorName == profile.displayName
        && data.authorUsername == profile.usernameLower
        && data.authorPhotoURL == profile.photoURL
        && data.authorVerified == profile.verified
        && data.authorType == profile.accountType
        && data.imageURL is string && data.imageURL.size() >= 9 && data.imageURL.size() <= 1000
        && data.imageURL.matches('^https://.*')
        && data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 220
        && data.locationName is string && data.locationName.size() <= 100
        && ((profile.privacy == 'public' && data.visibility == 'public')
          || (profile.privacy == 'private' && data.visibility == 'followers'))
        && data.status == 'active'
        && ((data.durationHours == 24 && subscriptionActive(profile) && profile.plan in ['plus', 'cafe_pro']
            && data.expiresAt > request.time
            && data.expiresAt <= request.time + duration.value(24, 'h'))
          || (data.durationHours == 8 && profile.plan != 'plus' && profile.plan != 'cafe_pro'
            && data.expiresAt > request.time
            && data.expiresAt <= request.time + duration.value(8, 'h')));
    }
    function canReadMoment(data) {
      return signedIn() && data.status == 'active'
        && !blockedBetween(request.auth.uid, data.authorUid)
        && (data.visibility == 'public'
          || (data.visibility == 'followers'
            && exists(/databases/$(database)/documents/users/$(data.authorUid)/followers/$(request.auth.uid))));
    }
    function canListMoment(data) {
      return signedIn() && data.status == 'active'
        && (data.visibility == 'public'
          || (data.visibility == 'followers'
            && exists(/databases/$(database)/documents/users/$(data.authorUid)/followers/$(request.auth.uid))));
    }
    match /moments/{momentId} {
      allow get: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (canReadMoment(resource.data) && resource.data.expiresAt > request.time);
      allow list: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid)
        || canListMoment(resource.data);
      allow create: if signedIn()
        && profileCanPublishMoment(request.resource.data.authorUid)
        && validMoment(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['active','hidden']
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    function cafeIsActive(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return signedIn() && cafe.accountType == 'cafe' && subscriptionActive(cafe)
        && cafe.accountStatus == 'active'
        && cafe.plan in ['cafe_basic', 'cafe_pro'];
    }
    function canManageCafe(cafeUid) {
      return owner(cafeUid) && cafeIsActive(cafeUid);
    }
    function cafeIsDiscoverable(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return cafeIsActive(cafeUid) && cafe.privacy == 'public'
        && !blockedBetween(request.auth.uid, cafeUid);
    }
    function cafeOwnerMayEdit(cafeUid) {
      let cafe = get(/databases/$(database)/documents/users/$(cafeUid)).data;
      return owner(cafeUid) && cafe.accountType == 'cafe' && cafe.accountStatus != 'banned';
    }
    function validStoreHours(hours) {
      return hours is map
        && hours.keys().hasAll(['saturday','sunday','monday','tuesday','wednesday','thursday','friday'])
        && hours.keys().hasOnly(['saturday','sunday','monday','tuesday','wednesday','thursday','friday'])
        && hours.saturday is string && hours.saturday.size() <= 40
        && hours.sunday is string && hours.sunday.size() <= 40
        && hours.monday is string && hours.monday.size() <= 40
        && hours.tuesday is string && hours.tuesday.size() <= 40
        && hours.wednesday is string && hours.wednesday.size() <= 40
        && hours.thursday is string && hours.thursday.size() <= 40
        && hours.friday is string && hours.friday.size() <= 40;
    }
    function validStoreDetails(data, cafeUid) {
      return data.keys().hasAll(['ownerUid','country','city','currency','district','address','mapsURL','category','description','coverURL','logoURL','hours','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerUid','country','city','currency','district','address','mapsURL','category','description','coverURL','logoURL','hours','createdAt','updatedAt'])
        && data.ownerUid == cafeUid
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 60
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.currency is string && data.currency.matches('^[A-Z][A-Z][A-Z]$')
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 160
        && data.mapsURL is string && data.mapsURL.size() <= 1000
        && data.category in ['قهوة مختصة','مقهى','حلويات','فطور','جلسات خارجية']
        && data.description is string && data.description.size() <= 500
        && data.coverURL is string && data.coverURL.size() <= 1000
        && data.logoURL is string && data.logoURL.size() <= 1000
        && validStoreHours(data.hours);
    }
    match /cafes/{cafeUid} {
      allow get: if admin() || cafeOwnerMayEdit(cafeUid) || cafeIsDiscoverable(cafeUid);
      allow list: if false;
      allow create: if cafeOwnerMayEdit(cafeUid)
        && validStoreDetails(request.resource.data, cafeUid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin() || cafeOwnerMayEdit(cafeUid))
        && validStoreDetails(request.resource.data, cafeUid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    function validMenuItem(data, cafeUid) {
      return data.keys().hasAll(['ownerUid','name','description','price','category','available','imageURL','sortOrder','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerUid','name','description','price','category','available','imageURL','sortOrder','createdAt','updatedAt'])
        && data.ownerUid == cafeUid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 200
        && data.price is number && data.price >= 0 && data.price <= 10000
        && data.category in ['قهوة ساخنة', 'قهوة باردة', 'حلويات', 'فطور', 'أخرى']
        && data.available is bool
        && data.imageURL is string && data.imageURL.size() <= 1000
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 9999;
    }
    match /cafes/{cafeUid}/menuItems/{itemId} {
      allow read: if admin() || canManageCafe(cafeUid) || cafeIsDiscoverable(cafeUid);
      allow create: if canManageCafe(cafeUid)
        && validMenuItem(request.resource.data, cafeUid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (admin() || canManageCafe(cafeUid))
        && validMenuItem(request.resource.data, cafeUid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() || canManageCafe(cafeUid);
    }
  }
}
